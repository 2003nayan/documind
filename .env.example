APP_ENV=development

# Postgres (local docker-compose default; use Neon URL in production)
DATABASE_URL=postgresql+psycopg://documind:documind@localhost:5432/documind

# Qdrant (local docker-compose default; use Qdrant Cloud URL + key in production)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=chunks

# Embeddings: fastembed (local, default) or gemini
EMBEDDING_PROVIDER=fastembed
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5

# LLM: gemini | openrouter | extractive (offline stand-in, no key needed)
LLM_PROVIDER=extractive
LLM_FALLBACK_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Storage for PDF files served to the viewer
FILES_DIR=data/files

# Public demo guardrails
UPLOADS_ENABLED=true
MAX_UPLOAD_MB=10
MAX_UPLOAD_PAGES=20
UPLOADS_PER_IP_PER_DAY=3
CHATS_PER_IP_PER_DAY=30
CHATS_GLOBAL_PER_DAY=400
UPLOAD_TTL_HOURS=24
CORS_ORIGINS=http://localhost:3000
